Options -Indexes
DirectoryIndex index.html index.php

# Never serve database files, dumps, or repo internals, wherever they end up.
<FilesMatch "\.(sqlite|sqlite3|db|db-wal|db-shm|sqlite-wal|sqlite-shm|txt|md|py|sh|json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
RedirectMatch 404 /\.git
RedirectMatch 404 /(tools|data)(/|$)
